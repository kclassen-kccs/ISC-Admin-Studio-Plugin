# Provider: set ANTHROPIC_API_KEY, or AI_PROVIDER=bedrock to use the instance's IAM role.
ANTHROPIC_API_KEY=
AI_PROVIDER=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-haiku-4-5
BEDROCK_STRONG_MODEL_ID=anthropic.claude-opus-5
AI_MODEL=claude-haiku-4-5-20251001
AI_STRONG_MODEL=claude-opus-5

# Which ISC tenants may use this proxy. Callers send their tenant API base URL;
# it is checked against this regex (default: any *.api.identitynow.com tenant)
# and, if set, against the comma-separated ALLOWED_BASE_URLS list.
ALLOWED_BASE_URL_REGEX=^https://[a-z0-9-]+\.api\.identitynow(-demo)?\.com$
ALLOWED_BASE_URLS=

# Authenticated ISC path used to confirm the caller's token is genuine.
ISC_VALIDATE_PATH=/v3/public-identities-config

PORT=8080
