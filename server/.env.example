# SailPoint proxy server config
# Copy this to .env and fill in your values (optional — can also set via the UI)

PORT=3001

# Where persistent data lives (tenant sign-in clients, scan history). On a
# container host the default is ephemeral — point this at a mounted volume.
DATA_DIR=/data

# AES-256-GCM key encrypting the stored credential registry, 32 bytes as hex
# or base64: openssl rand -hex 32
# Keep it OUT of the data directory — the point is that disk alone is useless.
# Losing it means stored tenants must be registered again.
DATA_ENCRYPTION_KEY=

# REQUIRED — the OAuth client used for user sign-in (authorization code flow).
# Create one in ISC with grant types AUTHORIZATION_CODE + REFRESH_TOKEN and
# register a redirect URI of <app-origin>/auth/callback for every surface that
# signs in (local dev, the deployed web app, and the native custom scheme).
# Without these, sign-in returns "no SailPoint OAuth client configured".
# Per-tenant OAuth clients, as JSON. OAuth clients are tenant-scoped in ISC,
# so each tenant that should support sign-in needs its own registered client.
# Create one with: node scripts/register-oauth-client.js <tenant> <admin-id> <admin-secret>
SP_OAUTH_CLIENTS={"your-org":{"clientId":"...","clientSecret":"..."}}

# Legacy single-tenant pair; still honoured if SP_OAUTH_TENANT names its tenant.
SP_OAUTH_TENANT=your-org
SP_OAUTH_CLIENT_ID=your-oauth-client-id
SP_OAUTH_CLIENT_SECRET=your-oauth-client-secret

# Legacy client-credentials/PAT values. No longer used for sign-in — kept only
# for local scripts that call the API without a user session.
# SP_DEFAULT_TENANT=your-org
# SP_DEFAULT_CLIENT_ID=your-client-id
# SP_DEFAULT_CLIENT_SECRET=your-client-secret

# Optional local admin account. When BOTH are set, "Local Admin" appears in
# the sign-in dropdown; its session can do exactly one thing — remove stored
# OAuth client registrations (e.g. one whose client was deleted in SailPoint).
# It cannot see any credentials or reach any tenant data. Leave unset to
# disable entirely.
# LOCAL_ADMIN_USERNAME=admin
# LOCAL_ADMIN_PASSWORD=change-me

# Tenants registered by FULL HOST. A tenant name containing a "." is used as
# the complete API host exactly as typed (only https:// is added) instead of
# <name>.api.identitynow-demo.com. Because that host is where this server
# sends requests — and tenant registration can be called anonymously — a full
# host is only accepted when it ends in one of these domains. Comma-separated;
# setting this REPLACES the default list.
# TENANT_HOST_SUFFIXES=identitynow.com,identitynow-demo.com

# Optional AI provider — enables AI descriptions, workflow flowcharts and
# Operations fix suggestions. Exactly one of:
#   ANTHROPIC_API_KEY=sk-ant-...      (Anthropic API directly — local / test)
#   AI_PROVIDER=bedrock               (Amazon Bedrock via the instance role — production;
#                                      BEDROCK_MODEL_ID defaults to anthropic.claude-haiku-4-5)
# Most AI features use that small, fast model. A few hard generation tasks
# (Workflows > Create with AI) ask for a stronger one — override it with:
#   AI_STRONG_MODEL=claude-opus-5                       (Anthropic API; this is the default)
#   BEDROCK_STRONG_MODEL_ID=anthropic.claude-opus-5     (Bedrock; this is the default — the
#                                      model must be enabled for the account/region)
# ANTHROPIC_API_KEY=
